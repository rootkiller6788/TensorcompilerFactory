{
  "name": "mlp3",
  "note": "MatMul + BiasAdd + GELU —— 最典型的一段 MLP。中间夹一个 mul(x, 1.0)，用来让 normalize 有东西可做。全部维度都是 32 的倍数，否则分块会产生余数 tile，而余数会让「访存 = Π loops × elems」这个口径失真。",
  "tensors": [
    {
      "name": "A",
      "shape": [
        32,
        64
      ],
      "role": "input"
    },
    {
      "name": "B",
      "shape": [
        64,
        32
      ],
      "role": "input"
    },
    {
      "name": "bias",
      "shape": [
        32
      ],
      "role": "input"
    },
    {
      "name": "t0",
      "shape": [
        32,
        32
      ],
      "role": "intermediate"
    },
    {
      "name": "t1",
      "shape": [
        32,
        32
      ],
      "role": "intermediate"
    },
    {
      "name": "t2",
      "shape": [
        32,
        32
      ],
      "role": "intermediate"
    },
    {
      "name": "out",
      "shape": [
        32,
        32
      ],
      "role": "output"
    }
  ],
  "nodes": [
    {
      "op": "matmul",
      "inputs": [
        "A",
        "B"
      ],
      "output": "t0"
    },
    {
      "op": "mul",
      "inputs": [
        "t0"
      ],
      "output": "t1",
      "scalar": 1.0
    },
    {
      "op": "add",
      "inputs": [
        "t1",
        "bias"
      ],
      "output": "t2"
    },
    {
      "op": "gelu",
      "inputs": [
        "t2"
      ],
      "output": "out"
    }
  ],
  "outputs": [
    "out"
  ]
}
